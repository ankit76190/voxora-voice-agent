# Voxora Backend Environment Configuration (Placeholders only)

# Application Settings
PROJECT_NAME="Voxora Voice Agent API"
VERSION="0.3.0"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (Comma-separated URLs or JSON array)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001"

# Gemini Server-Side AI Configuration (Never expose to frontend client)
GEMINI_API_KEY="your-gemini-api-key-placeholder"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=12.0

# Database Configuration (Defaults to persistent local SQLite; supports managed PostgreSQL)
# Local SQLite default: sqlite+aiosqlite:///voxora_calls.db
# Managed PostgreSQL example: postgresql+asyncpg://voxora_user:your_password@localhost:5432/voxora_db
DATABASE_URL="sqlite+aiosqlite:///voxora_calls.db"

# Telephony Configuration (Provider Abstraction)
# Default is safe deterministic "mock" simulation with zero carrier fees
TELEPHONY_PROVIDER="mock"
TELEPHONY_ENABLE_REAL_CALLS=false
TELEPHONY_ACCOUNT_SID="placeholder_sid"
TELEPHONY_AUTH_TOKEN="placeholder_token"
TELEPHONY_PHONE_NUMBER="+15551234567"
TELEPHONY_RATE_LIMIT_PER_MINUTE=5
